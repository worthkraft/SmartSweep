#!/bin/bash

# Pre-commit hook to run SwiftLint
# Copy this file to .git/hooks/pre-commit and make it executable

echo "Running SwiftLint before commit..."

# Get all Swift files that are staged for commit
SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "\.swift$")

if [ -z "$SWIFT_FILES" ]; then
  echo "No Swift files to lint."
  exit 0
fi

# Check if SwiftLint is installed
if ! which swiftlint > /dev/null; then
  echo "Error: SwiftLint not installed. Please install it using 'brew install swiftlint'."
  echo "Commit aborted."
  exit 1
fi

# Run SwiftLint on staged Swift files
echo "$SWIFT_FILES" | xargs swiftlint lint --quiet

# Check SwiftLint exit code
LINT_EXIT_CODE=$?
if [ $LINT_EXIT_CODE -ne 0 ]; then
  echo "SwiftLint found issues. Please fix them before committing."
  echo "You can run './swiftlint-autocorrect.sh' to automatically fix some issues."
  exit 1
fi

echo "SwiftLint passed. Proceeding with commit."
exit 0